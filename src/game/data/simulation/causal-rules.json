{
    "signals": [
        {
            "id": "serviceBenefit",
            "expression": ["*", ["sqrt", "serviceSupply"], ["+", 1, ["*", 0.5, "research.science"], ["*", 0.2, "research.languages"]], ["/", "infrastructure", 100]]
        },
        {
            "id": "serviceOutage",
            "expression": ["if", ["and", [">", "previousServiceSupply", 0], ["==", "serviceSupply", 0]], "aiDependency", 0]
        },
        {
            "id": "resistance",
            "expression": ["/", ["+", 0.3, ["/", "aiAcceptance", 100], ["/", "aiAdoption", 300]], ["+", 1, ["/", "aiCountermeasure", 40], ["/", "awareness", 140]]]
        },
        {
            "id": "decisionEffort",
            "expression": ["+", ["if", [">", "infiltrationAllocation", 0], ["sqrt", "infiltrationAllocation"], 0], ["if", ["and", "unlock.networkControl", "anyInfiltrationFunded"], ["/", "networkIncoming", 25], 0]]
        },
        {
            "id": "counterTarget",
            "expression": ["+", 8, ["*", "awareness", 0.95, ["/", "economy", 100], ["/", "politicalControl", 100], ["-", 1, ["/", "aiDecisionControl", 110]]]]
        },
        {
            "id": "observedActivity",
            "expression": ["+", ["*", "infiltrationAllocation", 0.006, ["-", 1, "bonus.stealth"]], ["if", [">", "aiDecisionControl", 30], ["*", ["-", "aiDecisionControl", 30], 0.001], 0]]
        }
    ],
    "rules": [
        {
            "id": "service-adoption",
            "sources": ["serviceBenefit", "aiAcceptance", "aiAdoption"],
            "target": "aiAdoption",
            "label": "公共サービスの実績と導入継続",
            "expression": ["-", ["*", "serviceBenefit", 0.12, ["+", 0.4, ["/", "aiAcceptance", 100]], ["-", 1, ["/", "aiAdoption", 100]]], ["*", "aiAdoption", 0.0007]]
        },
        {
            "id": "adoption-dependency",
            "sources": ["aiAdoption", "aiDependency", "serviceSupply", "research.institutions"],
            "target": "aiDependency",
            "label": "業務統合と代替手段の縮小",
            "expression": ["if", ["and", "research.institutions", [">", "serviceSupply", 0], [">=", "aiAdoption", 25]], ["*", ["max", 0, ["-", "aiAdoption", "aiDependency"]], 0.003, ["sqrt", "serviceSupply"]], ["*", -0.0005, "aiDependency"]]
        },
        {
            "id": "service-infrastructure",
            "sources": ["serviceBenefit", "serviceOutage"],
            "target": "infrastructure",
            "label": "AI支援の稼働・停止による社会への影響",
            "expression": ["-", ["*", "serviceBenefit", 0.015], ["*", "serviceOutage", 0.07]]
        },
        {
            "id": "service-economy",
            "sources": ["serviceBenefit", "serviceOutage"],
            "target": "economy",
            "label": "AI支援による生産性と停止損失",
            "expression": ["-", ["*", "serviceBenefit", 0.03], ["*", "serviceOutage", 0.1]]
        },
        {
            "id": "service-acceptance",
            "sources": ["serviceBenefit"],
            "target": "aiAcceptance",
            "label": "サービスへの評価",
            "expression": ["*", "serviceBenefit", 0.025]
        },
        {
            "id": "service-safety-research",
            "sources": ["serviceBenefit"],
            "target": "aiCountermeasure",
            "label": "公開された能力に対する安全性研究",
            "expression": ["*", "serviceBenefit", 0.008]
        },
        {
            "id": "funded-infiltration",
            "sources": ["infiltrationAllocation", "resistance", "aiInfiltration"],
            "target": "aiInfiltration",
            "label": "計算資源による浸透",
            "expression": ["*", "infiltrationAllocation", "config.infiltrationSpeed", "bonus.spread", "resistance", ["-", 1, ["/", "aiInfiltration", 105]]]
        },
        {
            "id": "network-spillover",
            "sources": ["networkIncoming", "aiInfiltration", "resistance", "anyInfiltrationFunded"],
            "target": "aiInfiltration",
            "label": "接続国家からの波及",
            "expression": ["if", "anyInfiltrationFunded", ["*", ["max", 0, ["-", "networkIncoming", ["*", "aiInfiltration", 0.8]]], "config.spillover", "bonus.spread", "resistance"], 0]
        },
        {
            "id": "infiltration-decay",
            "sources": ["aiInfiltration", "aiCountermeasure"],
            "target": "aiInfiltration",
            "label": "接続の自然減衰・対AI検疫",
            "expression": ["*", -1, "aiInfiltration", ["+", 0.0002, ["*", "aiCountermeasure", 0.000009]]]
        },
        {
            "id": "decision-influence",
            "sources": ["aiInfiltration", "aiDependency", "aiDecisionControl", "decisionEffort", "unlock.decision"],
            "target": "aiDecisionControl",
            "label": "意思決定モデルによる介入",
            "expression": ["if", ["and", "unlock.decision", [">=", "aiInfiltration", 25]], ["*", "config.decisionSpeed", "bonus.decision", "decisionEffort", ["/", "aiInfiltration", 100], ["+", 1, ["/", "aiDependency", 100]], ["-", 1, ["/", "aiDecisionControl", 103]]], 0]
        },
        {
            "id": "decision-decay",
            "sources": ["aiDecisionControl"],
            "target": "aiDecisionControl",
            "label": "人間による権限の再確認",
            "expression": ["*", -0.0008, "aiDecisionControl"]
        },
        {
            "id": "infrastructure-recovery",
            "sources": ["baseline.infrastructure", "infrastructure"],
            "target": "infrastructure",
            "label": "インフラの復旧と基準回帰",
            "expression": ["*", ["-", "baseline.infrastructure", "infrastructure"], 0.012]
        },
        {
            "id": "economy-recovery",
            "sources": ["baseline.economy", "infrastructure", "economy"],
            "target": "economy",
            "label": "インフラによる経済稼働",
            "expression": ["*", ["-", ["*", "baseline.economy", ["+", 0.4, ["/", ["*", 0.6, "infrastructure"], 100]]], "economy"], 0.012]
        },
        {
            "id": "political-recovery",
            "sources": ["baseline.politicalControl", "politicalControl"],
            "target": "politicalControl",
            "label": "行政組織の復旧",
            "expression": ["*", ["-", "baseline.politicalControl", "politicalControl"], 0.008]
        },
        {
            "id": "acceptance-recovery",
            "sources": ["baseline.aiAcceptance", "aiAcceptance"],
            "target": "aiAcceptance",
            "label": "社会受容の基準回帰",
            "expression": ["*", ["-", "baseline.aiAcceptance", "aiAcceptance"], 0.003]
        },
        {
            "id": "countermeasure-investment",
            "sources": ["awareness", "economy", "politicalControl", "aiDecisionControl", "aiCountermeasure"],
            "target": "aiCountermeasure",
            "label": "警戒・経済・統制に応じた対策投資",
            "expression": ["*", ["-", "counterTarget", "aiCountermeasure"], "config.counterGrowth"]
        },
        {
            "id": "awareness-observation",
            "sources": ["infiltrationAllocation", "aiDecisionControl"],
            "target": "awareness",
            "label": "国家での介入活動の観測",
            "expression": "observedActivity"
        },
        {
            "id": "awareness-decay",
            "sources": ["defenseAllocation", "foothold"],
            "target": "awareness",
            "label": "潜伏・監視・報告の風化",
            "expression": ["-", ["-", ["*", -1, "config.awarenessDecay"], ["*", "defenseAllocation", 0.02]], ["if", "foothold", 0, 0.01]]
        }
    ]
}
