{
    "name": "kf-team-c",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "simulate": "node --experimental-strip-types scripts/simulate.ts",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "check:staged": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
        "hooks:install": "lefthook install",
        "hooks:check": "lefthook validate"
    },
    "dependencies": {
        "lucide-react": "1.63.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "lefthook": "2.2.2",
        "typescript": "~7.0.2",
        "vite": "^8.3.5"
    }
}
