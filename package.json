{
    "name": "kf-team-c",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "assets": "python scripts/build_assets.py",
        "test": "node --experimental-strip-types --test tests/map.test.ts tests/game.test.ts tests/data.test.ts",
        "simulate": "node --experimental-strip-types scripts/simulate.ts",
        "test:browser": "playwright test",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "hooks:install": "lefthook install",
        "hooks:check": "lefthook run pre-commit --force"
    },
    "dependencies": {
        "lucide-react": "1.62.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@playwright/test": "^1.56.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.1.0",
        "lefthook": "2.2.2",
        "typescript": "~5.9.3",
        "vite": "^7.2.0"
    }
}
